APP_NAME=amrutam-telemedicine
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.1.0

POSTGRES_DB=amrutam_telemedicine
POSTGRES_USER=amrutam
POSTGRES_PASSWORD=replace-with-a-url-safe-password
DATABASE_URL=postgresql+asyncpg://amrutam:replace-with-a-url-safe-password@postgres:5432/amrutam_telemedicine

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
MFA_ISSUER=Amrutam Telemedicine
CORS_ORIGINS=https://telemedicine.example.com

LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_SECONDS=60
REGISTRATION_RATE_LIMIT=3
REGISTRATION_RATE_LIMIT_SECONDS=60
REFRESH_RATE_LIMIT=10
REFRESH_RATE_LIMIT_SECONDS=60
MFA_RATE_LIMIT=5
MFA_RATE_LIMIT_SECONDS=60

GRAFANA_ADMIN_PASSWORD=replace-with-a-random-password
LOG_LEVEL=INFO

# Copy this file to .env and replace every placeholder before deployment.
